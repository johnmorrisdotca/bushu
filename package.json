{
  "name": "@johnmorrisdotca/bushu",
  "version": "1.0.1",
  "description": "Bushu 部首, find a kanji by the parts it is made of: choose radicals and get every kanji that holds them all. The 253 radicals and their 6,355 kanji from RADKFILE, and a radical picker for any page, in English and Japanese. Zero dependencies.",
  "keywords": [
    "kanji",
    "radical",
    "radicals",
    "bushu",
    "multi-radical",
    "radical-lookup",
    "kanji-lookup",
    "kanji-search",
    "radkfile",
    "kradfile",
    "kanjidic",
    "edrdg",
    "japanese",
    "dictionary",
    "learning",
    "custom-element",
    "web-component",
    "typescript",
    "javascript",
    "zero-dependencies",
    "browser",
    "node",
    "itsutsu"
  ],
  "homepage": "https://johnmorrisdotca.github.io/bushu/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/bushu.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/bushu/issues"
  },
  "author": "John Morris",
  "license": "(MIT AND CC-BY-SA-4.0 AND CC-BY-4.0)",
  "type": "module",
  "sideEffects": [
    "./dist/element-define.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./radkfile": {
      "types": "./dist/data/radkfile.data.d.ts",
      "import": "./dist/data/radkfile.data.js",
      "default": "./dist/data/radkfile.data.js"
    },
    "./names": {
      "types": "./dist/names.d.ts",
      "import": "./dist/names.js",
      "default": "./dist/names.js"
    },
    "./strokes": {
      "types": "./dist/strokes.d.ts",
      "import": "./dist/strokes.js",
      "default": "./dist/strokes.js"
    },
    "./picker": {
      "types": "./dist/picker-entry.d.ts",
      "import": "./dist/picker-entry.js",
      "default": "./dist/picker-entry.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./element/define": {
      "types": "./dist/element-define.d.ts",
      "import": "./dist/element-define.js",
      "default": "./dist/element-define.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "family:readme": "node scripts/family-readme.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build",
    "site": "pnpm build && node scripts/site.mjs",
    "test:demo": "pnpm site && playwright test",
    "pictures": "pnpm site && node scripts/readme-pictures.mjs",
    "docs:make": "node scripts/docs.mjs",
    "data": "node scripts/build-data.mjs && node --experimental-strip-types scripts/build-names.ts",
    "data:radkfile": "node scripts/build-data.mjs",
    "data:names": "node --experimental-strip-types scripts/build-names.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.11.0"
}
